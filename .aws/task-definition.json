{
  "family": "opensearch-backend-task",
  "executionRoleArn": "arn:aws:iam::124169034234:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "backend-api",
      "image": "124169034234.dkr.ecr.ap-south-1.amazonaws.com/opensearch-backend-repo:latest",
      "cpu": 256,
      "memory": 512,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512"
}